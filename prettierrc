{
	"importOrder": [
		"<BUILTIN_MODULES>",
		"<THIRD_PARTY_MODULES>",
		"^@/components/(.*)$",
		"^@/hooks/(.*)$",
		"^[./]"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"plugins": ["prettier-plugin-tailwindcss"],
	"tabWidth": 4,
	"tailwindAttributes": ["myClassList", "/data-.*/"],
	"tailwindFunctions": ["clsx", "cva"],
	"tailwindStylesheet": "./src/index.css",
	"useTabs": true
}
